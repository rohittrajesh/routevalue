# Local V2 development only. Copy to .env.v2.local (gitignored).
# Supply your existing V2 development credentials privately. Never use production.
GOOGLE_ROUTES_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Disabled by default. Set both to 1 only for one local development process.
ROUTEVALUE_TERRAIN_LIVE_ENABLED=0
ROUTEVALUE_TERRAIN_SINGLE_PROCESS_DEV=0

# The live trip default is now six calls; select exactly 5 or 6.
ROUTEVALUE_TERRAIN_REQUESTS_PER_TRIP=6
# process requires the single-process confirmation above.
# postgres requires migration f2b7c39a106d and a shared DATABASE_URL across workers.
# Neither setting enables live elevation by itself.
ROUTEVALUE_TERRAIN_QUOTA_MODE=process
