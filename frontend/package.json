{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts --mode e2e --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:schema": "cd ../backend && PYTHONPATH=src uv run python scripts/export_openapi.py ../frontend/openapi/openapi.json",
    "api:types": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.ts",
    "api:format": "prettier --write openapi/openapi.json src/api/generated/schema.ts",
    "api:generate": "npm run api:schema && npm run api:types && npm run api:format",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi/openapi.json src/api/generated/schema.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
